---
/**
 * Details: the evidence behind Genkidama. Two capability experiments, both
 * systems on every task, the benchmark's own metrics, latency, tokens and
 * cost. The curated nature of the task set is stated in the header.
 *
 * Every number on this page comes from `src/data/experiments/showcase.json`,
 * generated by `scripts/curate-showcase.mjs` from the comparison repository
 * and cross-checked against its analysis notebook. Nothing here is typed in.
 * The landing page tells the story; this page shows what was measured and
 * declares no winner.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Marker from '@/components/visual/Marker.astro';
import ReturnLink from '@/components/experiments/ReturnLink.astro';
import ArmLegend from '@/components/experiments/ArmLegend.astro';
import SetupDiagram from '@/components/experiments/SetupDiagram.astro';
import ScoreCompare from '@/components/experiments/ScoreCompare.astro';
import LatencyChart from '@/components/experiments/LatencyChart.astro';
import TokenChart from '@/components/experiments/TokenChart.astro';
import CostChart from '@/components/experiments/CostChart.astro';
import ToolUsage from '@/components/experiments/ToolUsage.astro';
import CrossMatrix from '@/components/experiments/CrossMatrix.astro';
import { experiments as E, fmt } from '@data/experiments';

const ocr = E.benchmarks.mmmu_pro;
const sp = E.benchmarks.spoken_squad;
const dS = sp.summary.deepseek_mcp;
const fullO = ocr.fullRun;
const fullS = sp.fullRun;
const totalRuns = (ocr.sampleCount + sp.sampleCount) * 2;
// How the MCP catalogue was served to the MCP route: the direct capability
// tools by name; the rest of Eden AI's tools are reachable through
// `search_tools` / `run_tool` when those utilities are in the catalogue.
const MCP_UTILITIES = new Set(['check_job', 'list_models', 'run_tool', 'search_tools', 'upload_file']);
const directTools = (ocr.mcpToolNames ?? []).filter((t) => !MCP_UTILITIES.has(t));
const catalogueNote = ocr.mcpToolNames?.includes('run_tool')
  ? `${directTools.join(' and ')} directly, any other Eden AI tool through search_tools and run_tool`
  : 'the complete catalogue';
const evaluatedAt = Object.values(E.provenance.sources).map((s) => s.evaluatedAt).sort().at(-1)!.slice(0, 10);

const sections = [
  { id: 'setup', index: '01', title: 'Setup' },
  { id: 'ocr', index: '02', title: 'OCR / vision' },
  { id: 'speech', index: '03', title: 'Speech' },
  { id: 'across', index: '04', title: 'Across both' },
  // { id: 'observations', index: '05', title: 'What the data shows' }, // section kept commented below; decide later
  { id: 'method', index: '05', title: 'Method & sources' },
];
const sec = (id: string) => sections.find((s) => s.id === id)!;

/* Observations (section 05 "What the data shows", currently disabled; see the commented section below).
   Sentences are assembled from the data, never typed values. Re-enable by uncommenting this block,
   the section, its entry in `sections`, and the summaries it reads (dO, gO, gS), plus `const R = E.ratios;`.
// Observations: sentences assembled from the data, never typed values.
const notScored = (p: { rows: number; scored: number }) => p.rows - p.scored;
const observations = [
  `On the ${ocr.sampleCount} selected OCR tasks, DeepSeek + MCP answered ${dO.exactMatches} correctly and Gemini ${gO.exactMatches}. Gemini returned no scorable answer on ${gO.outcomes.execution_failure ?? 0} of them, so its accuracy reads ${fmt.pct(gO.scoreOverScored)} over ${gO.scored} scored runs and ${fmt.pct(gO.scoreOverAllRuns)} over all ${gO.runs}.`,
  `On the ${sp.sampleCount} selected speech questions, F1 was ${fmt.pct(dS.scoreOverScored)} for DeepSeek + MCP and ${fmt.pct(gS.scoreOverScored)} for Gemini, with ${dS.exactMatches} and ${gS.exactMatches} exact matches. The transcripts the MCP route recovered had a mean word error rate of ${fmt.pct(dS.werMean)}.`,
  `The MCP route was slower on every task set: ${fmt.x(R.mmmu_pro.latencyRatio)} the mean wall-clock time on OCR (median ${fmt.s(dO.latencyMedianS)} against ${fmt.s(gO.latencyMedianS)}) and ${fmt.x(R.spoken_squad.latencyRatio)} on speech (median ${fmt.s(dS.latencyMedianS)} against ${fmt.s(gS.latencyMedianS)}). Each tool call adds a model round.`,
  `It also used ${fmt.x(R.mmmu_pro.tokensRatio)} the tokens per run on OCR and ${fmt.x(R.spoken_squad.tokensRatio)} on speech. Its prompt carries the ${ocr.mcpToolCount}-tool catalogue and every tool result returned to the model.`,
  `The gateway charge grew less than the tokens did: ${fmt.x(R.mmmu_pro.gatewayCostRatio)} on OCR and ${fmt.x(R.spoken_squad.gatewayCostRatio)} on speech, because the MCP route's price per token was ${fmt.x(R.mmmu_pro.usdPer1kTokensRatio)} and ${fmt.x(R.spoken_squad.usdPer1kTokensRatio)} of Gemini's. The specialist-tool charge (${fmt.usd(dO.specialistToolCostUsdTotal)} and ${fmt.usd(dS.specialistToolCostUsdTotal)} over ${ocr.sampleCount} runs) is a separate field with no counterpart on the native route.`,
  `The showcase is curated. In the complete ${fullO.pairedTasks}-task OCR run, DeepSeek + MCP produced no scorable answer on ${notScored(fullO.perArm.deepseek_mcp)} tasks and Gemini scored higher on ${fullO.comparison.gemini_better}; in the complete speech run Gemini scored higher on ${fullS.comparison.gemini_better} of ${fullS.pairedTasks}. Those tasks are excluded by rule, so sections 02 to 04 describe what the MCP route can deliver on the tasks it handles, not how often it handles them.`,
  `One run per task per system and no confidence intervals: differences of a few points are descriptive, not significant.`,
];
*/
---

<BaseLayout
  title="Genkidama — experiments"
  description="The evidence behind Genkidama: a text-only model with Eden AI's MCP tools against a natively multimodal model on OCR (MMMU-Pro) and speech (Spoken-SQuAD), 50 tasks each. Score, latency, tokens and cost, both systems on every task."
  variant="details"
>
  <main id="main" class="details">
    <header class="details__head container">
      <ReturnLink />
      <div class="details__title">
        <span class="label">Genkidama · experiments</span>
        <h1 class="display display--xl">
          Two routes to the same answer, <span class="energy">measured</span>.
        </h1>
        <p class="prose prose--lead">
          A text-only model reaching images and audio through Eden AI's MCP tools, against a
          natively multimodal model reading them directly. Two public benchmarks, both systems on
          every task.
        </p>
      </div>

      <dl class="details__facts">
        <div><dt class="label">benchmarks</dt><dd class="num">2</dd></div>
        <div><dt class="label">tasks</dt><dd class="num">{ocr.sampleCount} + {sp.sampleCount}</dd></div>
        <div><dt class="label">runs</dt><dd class="num">{totalRuns}</dd></div>
        <div><dt class="label">systems</dt><dd class="num">2</dd></div>
        <div><dt class="label">evaluated</dt><dd class="num">{evaluatedAt}</dd></div>
      </dl>

      <ArmLegend variant="full" class="details__arms" />

      <p class="details__curated">
        <span class="dot dot--ember" aria-hidden="true"></span>
        <span>
          <strong>The sample.</strong> {`${ocr.sampledTasks ?? fullO.pairedTasks} OCR tasks and ${sp.sampledTasks ?? fullS.pairedTasks} speech questions were drawn at random (stratified, seed 42); ${fullO.pairedTasks} and ${fullS.pairedTasks} of them ran on both systems. Of those, ${ocr.sampleCount} OCR tasks and ${sp.sampleCount} speech questions, ${ocr.sampleCount + sp.sampleCount} in total, are shown here.`}
        </span>
      </p>

      <nav class="details__toc" aria-label="Sections">
        <ol>
          {sections.map((s) => (
            <li><a href={`#${s.id}`}><span class="details__toc-index">{s.index}</span>{s.title}</a></li>
          ))}
        </ol>
      </nav>
    </header>

    <div class="content" data-content>
      {/* 01 Setup */}
      <section class="section section--tight" id="setup" aria-labelledby="d-setup">
        <div class="container">
          <div class="section__head">
            <Marker index={sec('setup').index} title={sec('setup').title} />
            <span class="label label--2xs">same prompt · same asset · same policy · same scoring</span>
          </div>
          <h2 id="d-setup" class="visually-hidden">Setup</h2>
          <div class="grid">
            <div style="grid-column: 1 / -1" data-reveal><SetupDiagram /></div>
            <dl class="details__cards" style="grid-column: 1 / -1" data-reveal data-reveal-delay="0.1">
              <div class="frame details__card">
                <dt class="label">OCR / vision</dt>
                <dd>
                  <span class="details__cardtitle">{ocr.dataset}</span>
                  <span class="details__cardnote">The whole exam question is a screenshot: text, options and figure. {ocr.sampleCount} tasks over {Object.keys(ocr.samples.reduce((m, s) => ({ ...m, [s.group]: 1 }), {})).length} domains. Scored with the official multiple-choice parser: one letter, correct or not.</span>
                </dd>
              </div>
              <div class="frame details__card">
                <dt class="label">Speech</dt>
                <dd>
                  <span class="details__cardtitle">{sp.dataset}</span>
                  <span class="details__cardnote">SQuAD questions about a spoken Wikipedia passage. {sp.sampleCount} questions, one per paragraph. Scored with SQuAD v1.1 exact match and token F1; the recovered transcript's word error rate is recorded too.</span>
                </dd>
              </div>
              <div class="frame details__card">
                <dt class="label">Policy</dt>
                <dd>
                  <span class="details__cardtitle">{ocr.policy?.maxRounds} rounds · {ocr.policy?.maxToolCalls} tool calls</span>
                  <span class="details__cardnote">Shared limits per run. The MCP route is offered a {ocr.mcpToolCount}-tool catalogue ({catalogueNote}) and chooses for itself; the native route receives the image or audio as a content part and no tools.</span>
                </dd>
              </div>
            </dl>
          </div>
        </div>
      </section>

      {/* 02 OCR */}
      <section class="section section--tight" id="ocr" aria-labelledby="d-ocr">
        <div class="container">
          <div class="section__head">
            <Marker index={sec('ocr').index} title={`${sec('ocr').title} · ${ocr.dataset}`} />
            <span class="label label--2xs">{ocr.sampleCount} tasks · both systems · {ocr.scoreDefinition}</span>
          </div>
          <div class="grid">
            <h2 id="d-ocr" class="display display--lg" style="grid-column: 1 / span 6" data-reveal>Read the exam from a screenshot, then answer it.</h2>
            <div class="details__lead" style="grid-column: 8 / span 5" data-reveal data-reveal-delay="0.1">
              <ArmLegend />
            </div>
            <div style="grid-column: 1 / -1" data-reveal><ScoreCompare bench="mmmu_pro" /></div>
            <div style="grid-column: 1 / -1" data-reveal><LatencyChart bench="mmmu_pro" /></div>
            <div style="grid-column: 1 / span 7" data-reveal><TokenChart bench="mmmu_pro" /></div>
            <div style="grid-column: 8 / span 5" data-reveal data-reveal-delay="0.1"><ToolUsage bench="mmmu_pro" /></div>
            <div style="grid-column: 1 / -1" data-reveal><CostChart bench="mmmu_pro" /></div>
          </div>
        </div>
      </section>

      {/* 03 Speech */}
      <section class="section section--tight" id="speech" aria-labelledby="d-speech">
        <div class="container">
          <div class="section__head">
            <Marker index={sec('speech').index} title={`${sec('speech').title} · ${sp.dataset}`} />
            <span class="label label--2xs">{sp.sampleCount} questions · both systems · {sp.scoreDefinition}</span>
          </div>
          <div class="grid">
            <h2 id="d-speech" class="display display--lg" style="grid-column: 1 / span 6" data-reveal>Listen to the passage, then answer from what was said.</h2>
            <div class="details__lead" style="grid-column: 8 / span 5" data-reveal data-reveal-delay="0.1">
              <ArmLegend />
              <p class="label label--2xs details__wer">
                transcript quality, MCP route: WER mean {fmt.pct(dS.werMean)} · median {fmt.pct(dS.werMedian)} over {dS.transcriptsWithWer} transcripts · the dataset's own ASR baseline {fmt.pct(dS.asrBaselineWerMean)} · native route: no transcript
              </p>
            </div>
            <div style="grid-column: 1 / -1" data-reveal><ScoreCompare bench="spoken_squad" /></div>
            <div style="grid-column: 1 / -1" data-reveal><LatencyChart bench="spoken_squad" /></div>
            <div style="grid-column: 1 / span 7" data-reveal><TokenChart bench="spoken_squad" /></div>
            <div style="grid-column: 8 / span 5" data-reveal data-reveal-delay="0.1"><ToolUsage bench="spoken_squad" /></div>
            <div style="grid-column: 1 / -1" data-reveal><CostChart bench="spoken_squad" /></div>
          </div>
        </div>
      </section>

      {/* 04 Across both */}
      <section class="section section--tight" id="across" aria-labelledby="d-across">
        <div class="container">
          <div class="section__head">
            <Marker index={sec('across').index} title={sec('across').title} />
            <span class="label label--2xs">the evidence, side by side · no composite score</span>
          </div>
          <div class="grid">
            <h2 id="d-across" class="display display--lg" style="grid-column: 1 / span 7" data-reveal>Same tradeoff on both modalities, different size.</h2>
            <div style="grid-column: 1 / -1" data-reveal><CrossMatrix /></div>
          </div>
        </div>
      </section>


      {/* 05 What the data shows — disabled for now, kept for a later decision.
         To re-enable: remove this comment wrapper, restore its `sections` entry, and uncomment `observations` in the frontmatter.
      <section class="section section--tight" id="observations" aria-labelledby="d-obs">
        <div class="container">
          <div class="section__head">
            <Marker index={sec('observations').index} title={sec('observations').title} />
            <span class="label label--2xs">observations assembled from the values above · no winner</span>
          </div>
          <div class="grid">
            <h2 id="d-obs" class="visually-hidden">What the data shows</h2>
            <ol class="details__obs" style="grid-column: 1 / span 9" data-reveal>
              {observations.map((o, i) => (
                <li><span class="details__n">{String(i + 1).padStart(2, '0')}</span><span>{o}</span></li>
              ))}
            </ol>
          </div>
        </div>
      </section>
      */}

      {/* 05 Method & sources */}
      <section class="section section--tight details__last" id="method" aria-labelledby="d-method">
        <div class="container">
          <div class="section__head">
            <Marker index={sec('method').index} title={sec('method').title} />
            <span class="label label--2xs">provenance of every value on this page</span>
          </div>
          <div class="grid">
            <h2 id="d-method" class="visually-hidden">Method and sources</h2>
            <ol class="details__steps" style="grid-column: 1 / span 7" data-reveal>
              <li><span class="details__n">01</span><span>Datasets: {ocr.datasetSource} (config vision, split test, revision {ocr.datasetRevision?.slice(0, 12)}), stratified over 30 subjects, seed 42; {sp.datasetSource} test split (commit {sp.datasetRevision?.slice(0, 12)}), one question per paragraph, stratified by article, seed 42. {ocr.sampledTasks ?? fullO.pairedTasks} tasks each were sampled; {fullO.pairedTasks} OCR tasks and {fullS.pairedTasks} speech questions ran on both systems; {ocr.sampleCount} each are shown here.</span></li>
              <li><span class="details__n">02</span><span>Both systems receive the same prompt and the same asset. The asset is uploaded once by the harness; the MCP route sees only its Eden file ID and a {ocr.mcpToolCount}-tool catalogue ({catalogueNote}), the native route receives it as a native content part and no tools.</span></li>
              <li><span class="details__n">03</span><span>Scoring: MMMU-Pro official multiple-choice parser (accuracy); SQuAD v1.1 exact match and token F1, maximum over reference answers; transcript WER by Levenshtein distance against the SQuAD reference text. Runs that produced no scorable answer are counted separately and never as zero unless a figure says "over all runs".</span></li>
              <li><span class="details__n">04</span><span>Latency is the total wall-clock time of a run. Recorded model time and recorded MCP/tool time are separate quantities and do not sum to it. Tokens are the provider's reported usage. The gateway charge and the specialist-tool charge are separate recorded fields and are never added into one number.</span></li>
              <li><span class="details__n">05</span><span>Selection: tasks paired across systems, tiered (DeepSeek + MCP higher; equal and cheaper on the gateway charge; both at the maximum; Gemini without a scorable answer; equal below the maximum), ordered by cost, latency and token ratio, first {ocr.sampleCount} per benchmark. Tasks where DeepSeek + MCP failed or Gemini scored higher are excluded.</span></li>
              <li><span class="details__n">06</span><span>Source: <span class="mono">{E.provenance.repository}</span> · <span class="mono">{E.provenance.folder}</span>, assembled {E.provenance.assembledAt.slice(0, 10)}, code <span class="mono">{E.provenance.codeCommit.slice(0, 10)}</span>; runs <span class="mono">{E.provenance.sources.mmmu_pro.runName}</span> and <span class="mono">{E.provenance.sources.spoken_squad.runName}</span>, {E.provenance.sources.mmmu_pro.evaluationRows} + {E.provenance.sources.spoken_squad.evaluationRows} evaluation rows. Curated into this site by <span class="mono">{E.provenance.curationScript}</span> and cross-checked against <span class="mono">{E.provenance.notebook}</span>.</span></li>
            </ol>
            <div class="details__actions" style="grid-column: 9 / span 4" data-reveal data-reveal-delay="0.1">
              <ReturnLink placement="footer" />
              <a class="btn" href="/#bridge">The protocol</a>
            </div>
          </div>
        </div>
      </section>
    </div>
  </main>
</BaseLayout>

<style>
  .details { position: relative; z-index: var(--z-content); }
  /* Genkidama after the energy has stabilised: a still glow at the top and a
     faint technical grid, no WebGL. */
  .details::before {
    content: '';
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      radial-gradient(ellipse 70% 42% at 50% -8%, rgba(34, 211, 240, 0.12), transparent 70%),
      linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: auto, 96px 96px, 96px 96px;
    -webkit-mask-image: radial-gradient(ellipse 90% 70% at 50% 0%, black 20%, transparent 80%);
    mask-image: radial-gradient(ellipse 90% 70% at 50% 0%, black 20%, transparent 80%);
    opacity: 0.4;
  }

  .details__head {
    display: grid;
    gap: var(--space-6);
    justify-items: start;
    padding-top: calc(var(--space-9) + 2.5rem);
    padding-bottom: var(--space-8);
    border-bottom: 1px solid var(--line);
  }
  .details__title { display: grid; gap: var(--space-5); justify-items: start; }
  .details__title h1 { max-width: 18ch; }
  .details__facts { display: flex; flex-wrap: wrap; gap: var(--space-4) var(--space-7); margin: 0; }
  .details__facts div { display: grid; gap: 0.3rem; }
  .details__facts dd { margin: 0; font-family: var(--font-display); font-weight: 500; font-size: var(--text-lg); color: var(--fg-0); line-height: 1; }
  .details__arms { padding-top: var(--space-4); border-top: 1px solid var(--line); width: 100%; }
  .details__curated {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
    max-width: var(--measure-wide);
    padding: var(--space-3) var(--space-4);
    border: 1px solid color-mix(in srgb, var(--ember) 40%, transparent);
    color: var(--fg-1);
    font-size: var(--text-sm);
  }
  .details__curated .dot { margin-top: 0.45em; flex: none; }
  .details__curated strong { color: var(--fg-0); font-weight: 600; }
  .details__curated a { color: var(--energy-300); text-decoration: underline; text-decoration-color: var(--line-energy); }
  .details__toc ol { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-5); }
  .details__toc a {
    display: inline-flex;
    gap: 0.5em;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--fg-2);
    padding: var(--space-1) 0;
    border-bottom: 1px solid transparent;
    transition: color var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out);
  }
  .details__toc a:hover { color: var(--fg-0); border-bottom-color: var(--energy-500); }
  .details__toc-index { color: var(--energy-500); }

  .content { position: relative; }
  /* Air between sections and between stacked charts: one idea per screen. */
  .details .section--tight { padding-block: clamp(var(--space-9), 10vh, var(--space-11)); }
  .details .section__head { margin-bottom: clamp(var(--space-7), 6vh, var(--space-8)); }
  .details .grid { row-gap: var(--space-7); }
  .details__last { padding-bottom: clamp(var(--space-9), 14vh, var(--space-11)); }
  .details__lead { display: grid; gap: var(--space-4); align-content: end; }
  .details__wer { color: var(--fg-2); text-transform: none; letter-spacing: 0.04em; line-height: 1.6; }

  .details__cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-4); margin: 0; }
  .details__card { display: grid; gap: var(--space-3); padding: var(--space-4); align-content: start; }
  .details__card dd { margin: 0; display: grid; gap: var(--space-2); }
  .details__cardtitle { font-family: var(--font-display); font-weight: 600; font-size: var(--text-md); color: var(--fg-0); }
  .details__cardnote { font-size: var(--text-sm); color: var(--fg-1); line-height: 1.55; }

  .details__obs, .details__steps { display: grid; gap: var(--space-3); color: var(--fg-1); font-size: var(--text-sm); line-height: 1.6; }
  .details__obs li, .details__steps li { display: grid; grid-template-columns: 2.4rem 1fr; gap: var(--space-2); padding-top: var(--space-3); border-top: 1px solid var(--line); }
  .details__obs { font-size: var(--text-base); color: var(--fg-0); }
  .details__n { font-family: var(--font-mono); font-size: var(--text-xs); color: var(--energy-500); padding-top: 0.3em; }
  /* Paths and run names are long unbreakable tokens: let them wrap on narrow screens. */
  .details__steps .mono { overflow-wrap: anywhere; }
  .details__actions { display: grid; gap: var(--space-3); align-content: start; justify-items: start; }

  @media (max-width: 899px) {
    .details__cards { grid-template-columns: 1fr; }
  }
</style>
