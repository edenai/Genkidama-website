---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Stage from '@/components/visual/Stage.astro';
import Hero from '@/components/sections/Hero.astro';
import Story from '@/components/sections/Story.astro';
import Gap from '@/components/sections/Gap.astro';
import Bridge from '@/components/sections/Bridge.astro';
import Experiments from '@/components/sections/Experiments.astro';
---

<BaseLayout
  title="Genkidama — give any model access to any capability"
  description="An Eden AI research project: a text-only model gathers vision, speech, OCR and web capabilities through Eden AI's MCP server, measured against a natively multimodal model on MMMU-Pro and Spoken-SQuAD."
>
  <Stage />
  <main id="main">
    <Hero />
    <Story />
    <div class="content" data-content>
      <Gap />
      <Bridge />
      <Experiments />
    </div>
  </main>
</BaseLayout>

<style>
  main { position: relative; z-index: var(--z-content); }
  /* Content sits on a translucent surface so the dimmed system stays faintly
     alive underneath; a soft edge at the top lets the story hand over. */
  .content {
    position: relative;
    background: rgba(5, 7, 8, 0.86);
    border-top: 1px solid var(--line);
  }
  .content::before {
    content: '';
    position: absolute;
    left: 0; right: 0;
    top: -30vh;
    height: 30vh;
    background: linear-gradient(to bottom, transparent, rgba(5, 7, 8, 0.86));
    pointer-events: none;
  }
</style>
