---
/**
 * GENKIDAMA as part of the visual system. In the hero, "DAMA" is hollow so
 * the core burns through it while "GENKI" stays solid; the letters converge
 * on load (see animations/scroll/hero.ts). In the story's Gathering the same
 * word re-forms at the moment of convergence (animations/scroll/gathering.ts)
 * with every letter solid, in the same color as the hero's "GENKI". The hero
 * instance is the default: `as`, `decorative` and `variant` default to its
 * markup.
 */
interface Props {
  /** Element to render. The hero is the page's h1; the Gathering is a decorative p. */
  as?: 'h1' | 'p' | 'div';
  /** Hidden from assistive tech (the heading next to it carries the meaning). */
  decorative?: boolean;
  /** `gathering`: hidden until the convergence assembles it; all letters solid. */
  variant?: 'hero' | 'gathering';
}
const { as: Tag = 'h1', decorative = false, variant = 'hero' } = Astro.props;
const word = 'GENKIDAMA';
const letters = word.split('');
// Hero only: D A M A are hollow. The Gathering renders the whole word solid.
const hollow = variant === 'hero' ? new Set([5, 6, 7, 8]) : new Set<number>();
---

<Tag
  class:list={['wordmark', { 'wordmark--gathering': variant === 'gathering' }]}
  aria-label={decorative ? undefined : word}
  aria-hidden={decorative ? 'true' : undefined}
>
  {letters.map((l, i) => (
    <span class:list={['wordmark__letter', { 'wordmark__letter--hollow': hollow.has(i) }]} aria-hidden="true">{l}</span>
  ))}
</Tag>

<style>
  .wordmark {
    display: flex;
    justify-content: center;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-wordmark);
    line-height: 0.95;
    letter-spacing: 0;
    color: var(--fg-0);
    margin: 0;
    /* Trim optical side bearings created by tracking */
    padding-left: 0.14em;
  }
  .wordmark__letter {
    display: inline-block;
    margin-right: var(--tracking-wordmark);
    will-change: transform, opacity;
  }
  .wordmark__letter--hollow {
    color: transparent;
    -webkit-text-stroke: 1.5px var(--fg-0);
    paint-order: stroke fill;
  }

  /* Gathering: hidden until the convergence assembles it (JS + motion only).
     All letters are solid here, so there is no hollow/charged treatment. */
  html.js:not(.reduced-motion) .wordmark--gathering .wordmark__letter { opacity: 0; }
  @media (max-width: 640px) {
    .wordmark { font-size: clamp(2.2rem, 0.6rem + 8.4vw, 4rem); padding-left: 0.08em; }
    .wordmark__letter { margin-right: 0.08em; }
    .wordmark__letter--hollow { -webkit-text-stroke-width: 1px; }
  }
</style>
