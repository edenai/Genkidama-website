---
/**
 * The uncurated picture: every paired task of the complete source runs (100
 * per benchmark), how the two systems compared on each, each system's
 * outcomes and score over all runs, and how the 50 showcased tasks were
 * selected from them. Shown so the curated sections are never read alone.
 */
import { experiments, ARMS, fmt, outcomeLabel, type BenchmarkId } from '@data/experiments';
import { armFill, armInk } from './chart';

interface Props { bench: BenchmarkId }
const { bench } = Astro.props;
const b = experiments.benchmarks[bench];
const arms = experiments.arms;
const full = b.fullRun;
const cmp = full.comparison;
const cats: { key: string; label: string; cls: string }[] = [
  { key: 'deepseek_better', label: 'DeepSeek + MCP higher score', cls: 'd' },
  { key: 'equal', label: 'equal score', cls: 'eq' },
  { key: 'gemini_better', label: 'Gemini higher score', cls: 'g' },
  { key: 'gemini_not_scored', label: 'Gemini no scorable answer', cls: 'gn' },
  { key: 'deepseek_not_scored', label: 'DeepSeek + MCP no scorable answer', cls: 'dn' },
  { key: 'neither_scored', label: 'neither scored', cls: 'nn' },
];
const total = cmp.paired_tasks;
const tiers = b.tiers.filter((t) => t.tier !== null);
const excluded = b.tiers.filter((t) => t.tier === null);
const maxEligible = Math.max(...b.tiers.map((t) => t.eligible), 1);
---

<figure class="full frame">
  <figcaption class="frame__bar">
    <span class="label"><span class="dot dot--ember" aria-hidden="true"></span> complete runs · {b.title} · {full.pairedTasks} paired tasks</span>
    <span class="label label--2xs">uncurated · source run {experiments.provenance.sources[bench].runName}</span>
  </figcaption>

  <div class="full__body">
    <div class="full__block">
      <span class="label label--2xs">how each paired task compared · {b.scoreMetric}</span>
      <div class="full__strip" role="img" aria-label={cats.filter((c) => cmp[c.key]).map((c) => `${c.label}: ${cmp[c.key]}`).join('; ')}>
        {cats.filter((c) => cmp[c.key] > 0).map((c) => (
          <span class:list={['full__seg', `full__seg--${c.cls}`]} style={`flex-basis: ${(cmp[c.key] / total) * 100}%`} title={`${c.label}: ${cmp[c.key]} of ${total}`}>
            <span class="num">{cmp[c.key]}</span>
          </span>
        ))}
      </div>
      <ul class="full__legend">
        {cats.filter((c) => cmp[c.key] > 0).map((c) => (
          <li><span class:list={['full__key', `full__seg--${c.cls}`]} aria-hidden="true"></span><span class="label label--2xs">{c.label} · {cmp[c.key]}</span></li>
        ))}
      </ul>
    </div>

    <div class="full__arms">
      {ARMS.map((arm) => {
        const p = full.perArm[arm];
        return (
          <div class="full__arm" style={`--c: ${armFill(arm)}; --ink: ${armInk[arm]}`}>
            <div class="full__head"><span class="full__swatch" aria-hidden="true"></span><span class="full__name">{arms[arm].label}</span></div>
            <dl class="full__facts">
              <div><dt class="label label--2xs">{b.scoreMetric} over scored</dt><dd class="num full__ink">{fmt.pct(p.score_over_scored)} <span class="full__dim">({p.scored} of {p.rows})</span></dd></div>
              <div><dt class="label label--2xs">{b.scoreMetric} over all {p.rows} runs</dt><dd class="num full__ink">{fmt.pct(p.score_over_all_rows)}</dd></div>
              <div><dt class="label label--2xs">outcomes</dt><dd class="num">{Object.entries(p.outcomes).map(([o, n]) => `${outcomeLabel[o] ?? o} ${n}`).join(' · ')}</dd></div>
              <div><dt class="label label--2xs">latency mean · tokens mean</dt><dd class="num">{fmt.s(p.total_latency_mean_s)} · {fmt.int(p.total_tokens_mean)}</dd></div>
              <div><dt class="label label--2xs">gateway · specialist-tool charge, total</dt><dd class="num">{fmt.usd(p.gateway_cost_usd_total)} · {p.specialist_tool_cost_usd_total ? fmt.usd(p.specialist_tool_cost_usd_total) : 'no field'}</dd></div>
            </dl>
          </div>
        );
      })}
    </div>

    <div class="full__block">
      <span class="label label--2xs">how the {b.sampleCount} showcased tasks were selected · eligible → selected, by rule</span>
      <ol class="full__tiers">
        {tiers.map((t) => (
          <li class="full__tier">
            <span class="full__tiername"><span class="num full__tierno">{t.tier}</span>{t.label.replace(/_/g, ' ')}</span>
            <span class="full__tierbars" aria-hidden="true">
              <span class="full__eligible" style={`width: ${(t.eligible / maxEligible) * 100}%`}></span>
              <span class="full__selected" style={`width: ${(t.selected / maxEligible) * 100}%`}></span>
            </span>
            <span class="num full__tiern">{t.selected} / {t.eligible}</span>
          </li>
        ))}
        {excluded.filter((t) => t.eligible > 0).map((t) => (
          <li class="full__tier full__tier--excluded">
            <span class="full__tiername">{t.label.replace('excluded: ', '').replace(/_/g, ' ')} <span class="label label--2xs">excluded</span></span>
            <span class="full__tierbars" aria-hidden="true"><span class="full__eligible" style={`width: ${(t.eligible / maxEligible) * 100}%`}></span></span>
            <span class="num full__tiern">0 / {t.eligible}</span>
          </li>
        ))}
      </ol>
      <p class="full__note label label--2xs">selected / eligible per rule · a task is eligible only when DeepSeek + MCP did at least as well as Gemini; tasks where it produced no scorable answer, or where Gemini scored higher, are excluded by construction</p>
    </div>
  </div>
</figure>

<style>
  .full__body { display: grid; gap: var(--space-5); padding: var(--space-4); }
  .full__block { display: grid; gap: var(--space-3); }
  .full__strip { display: flex; height: 26px; gap: 2px; }
  .full__seg { display: grid; place-items: center; min-width: 2px; font-family: var(--font-mono); font-size: var(--text-2xs); color: var(--bg-0); overflow: hidden; }
  .full__seg .num { opacity: 0.95; }
  .full__seg--d { background: var(--series-mcp); color: var(--fg-0); }
  .full__seg--eq { background: var(--fg-1); }
  .full__seg--g { background: var(--series-native); color: var(--fg-0); }
  .full__seg--gn { background: repeating-linear-gradient(-45deg, var(--series-native) 0 3px, var(--bg-1) 3px 5px); color: var(--fg-0); }
  .full__seg--dn { background: repeating-linear-gradient(-45deg, var(--series-mcp) 0 3px, var(--bg-1) 3px 5px); color: var(--fg-0); }
  .full__seg--nn { background: var(--fg-3); color: var(--fg-0); }
  .full__legend { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-5); }
  .full__legend li { display: flex; align-items: center; gap: var(--space-2); }
  .full__key { width: 12px; height: 12px; display: inline-block; }
  .full__arms { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-5); }
  .full__arm { display: grid; gap: var(--space-3); align-content: start; padding-top: var(--space-3); border-top: 1px solid var(--line); }
  .full__head { display: flex; align-items: center; gap: var(--space-2); }
  .full__swatch { width: 10px; height: 10px; background: var(--c); }
  .full__name { font-family: var(--font-mono); font-size: var(--text-xs); letter-spacing: var(--tracking-label); text-transform: uppercase; color: var(--fg-0); }
  .full__facts { display: grid; gap: var(--space-2); margin: 0; }
  .full__facts div { display: grid; gap: 0.15rem; }
  .full__facts dt { color: var(--fg-3); text-transform: none; letter-spacing: 0.04em; }
  .full__facts dd { margin: 0; font-family: var(--font-mono); font-size: var(--text-sm); color: var(--fg-1); }
  .full__ink { color: var(--ink); }
  .full__dim { color: var(--fg-3); }
  .full__tiers { display: grid; gap: var(--space-2); }
  .full__tier { display: grid; grid-template-columns: 14rem minmax(0, 1fr) 4.5rem; align-items: center; gap: var(--space-3); font-size: var(--text-xs); }
  .full__tier--excluded { color: var(--fg-2); }
  .full__tiername { display: inline-flex; align-items: baseline; gap: 0.5em; color: var(--fg-1); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .full__tierno { color: var(--energy-500); font-family: var(--font-mono); }
  .full__tierbars { position: relative; height: 10px; background: var(--bg-2); }
  .full__eligible { position: absolute; inset: 0 auto 0 0; background: var(--fg-3); }
  .full__selected { position: absolute; inset: 0 auto 0 0; background: var(--series-mcp); }
  .full__tiern { font-family: var(--font-mono); text-align: right; color: var(--fg-1); }
  .full__note { color: var(--fg-3); text-transform: none; letter-spacing: 0.04em; }
  @media (max-width: 899px) { .full__arms { grid-template-columns: 1fr; } }
  @media (max-width: 640px) { .full__tier { grid-template-columns: 1fr; gap: var(--space-1); } }
</style>
