---
/**
 * Cost for one benchmark, both systems. Two recorded fields, kept apart:
 * the gateway charge for the model (both routes) and the specialist-tool
 * charge reported inside MCP results (MCP route only; the native route has no
 * such field). They are never added into one headline. The effective gateway
 * price per million tokens explains why more tokens did not mean
 * proportionally more money.
 */
import { experiments, ARMS, fmt, type BenchmarkId } from '@data/experiments';
import { armFill, armInk } from './chart';

interface Props { bench: BenchmarkId }
const { bench } = Astro.props;
const b = experiments.benchmarks[bench];
const arms = experiments.arms;
const r = experiments.ratios[bench];
const maxUsd = Math.max(...ARMS.flatMap((a) => [b.summary[a].gatewayCostUsdTotal ?? 0, b.summary[a].specialistToolCostUsdTotal ?? 0]));
const pct = (v: number | null | undefined) => `${((v ?? 0) / maxUsd) * 100}%`;
---

<figure class="cost frame">
  <figcaption class="frame__bar">
    <span class="label"><span class="dot dot--energy" aria-hidden="true"></span> cost · USD over {b.sampleCount} runs</span>
    <span class="label label--2xs">two recorded fields, kept separate</span>
  </figcaption>

  <div class="cost__body">
    <div class="cost__field">
      <h4 class="cost__title">Gateway charge <span class="label label--2xs">model + routing · both routes</span></h4>
      {ARMS.map((arm) => {
        const s = b.summary[arm];
        return (
          <div class="cost__row" style={`--c: ${armFill(arm)}; --ink: ${armInk[arm]}`}>
            <span class="cost__name"><span class="cost__swatch" aria-hidden="true"></span>{arms[arm].short}</span>
            <span class="cost__track" role="img" aria-label={`${arms[arm].label}: gateway charge ${fmt.usd(s.gatewayCostUsdTotal)} over ${s.runs} runs`}><span class="cost__bar" style={`width: ${pct(s.gatewayCostUsdTotal)}`}></span></span>
            <span class="cost__val num">{fmt.usd(s.gatewayCostUsdTotal)} <span class="cost__mean">· {fmt.usd(s.gatewayCostUsdMean, 4)} per run</span></span>
          </div>
        );
      })}
      <p class="cost__ratio label label--2xs">DeepSeek + MCP ÷ Gemini on the gateway charge: {fmt.x(r.gatewayCostRatio)}</p>
    </div>

    <div class="cost__field">
      <h4 class="cost__title">Specialist-tool charge <span class="label label--2xs">reported inside MCP results · MCP route only</span></h4>
      {ARMS.map((arm) => {
        const s = b.summary[arm];
        const has = s.runsWithSpecialistCost > 0;
        return (
          <div class="cost__row" style={`--c: ${armFill(arm)}; --ink: ${armInk[arm]}`}>
            <span class="cost__name"><span class="cost__swatch" aria-hidden="true"></span>{arms[arm].short}</span>
            {has ? (
              <>
                <span class="cost__track" role="img" aria-label={`${arms[arm].label}: specialist-tool charge ${fmt.usd(s.specialistToolCostUsdTotal)} over ${s.runs} runs`}><span class="cost__bar cost__bar--tool" style={`width: ${pct(s.specialistToolCostUsdTotal)}`}></span></span>
                <span class="cost__val num">{fmt.usd(s.specialistToolCostUsdTotal)} <span class="cost__mean">· reported on {s.runsWithSpecialistCost} of {s.runs} runs</span></span>
              </>
            ) : (
              <>
                <span class="cost__track cost__track--empty" aria-hidden="true"></span>
                <span class="cost__val label label--2xs cost__none">no such field · no tools on this route</span>
              </>
            )}
          </div>
        );
      })}
      <p class="cost__ratio label label--2xs">total recorded cost including specialist tools, DeepSeek + MCP ÷ Gemini gateway charge: {fmt.x(r.totalCostRatioInclSpecialist)}</p>
    </div>

    <div class="cost__field cost__field--price">
      <h4 class="cost__title">Effective gateway price <span class="label label--2xs">gateway charge ÷ tokens, mean per run · USD per 1M tokens</span></h4>
      <div class="cost__prices">
        {ARMS.map((arm) => (
          <div class="cost__price" style={`--c: ${armFill(arm)}; --ink: ${armInk[arm]}`}>
            <span class="cost__name"><span class="cost__swatch" aria-hidden="true"></span>{arms[arm].short}</span>
            <span class="cost__pricev num">{fmt.usd((b.summary[arm].usdPer1kTokens ?? 0) * 1000, 2)}</span>
          </div>
        ))}
        <p class="cost__ratio label label--2xs">price per token, DeepSeek + MCP ÷ Gemini: {fmt.x(r.usdPer1kTokensRatio)}</p>
      </div>
    </div>
  </div>
</figure>

<style>
  .cost__body { display: grid; gap: var(--space-5); padding: var(--space-4); }
  .cost__field { display: grid; gap: var(--space-3); padding-top: var(--space-3); border-top: 1px solid var(--line); }
  .cost__field:first-child { padding-top: 0; border-top: 0; }
  .cost__title { font-family: var(--font-display); font-weight: 600; font-size: var(--text-sm); letter-spacing: 0.04em; color: var(--fg-0); display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-3); }
  .cost__title .label { color: var(--fg-3); text-transform: none; letter-spacing: 0.04em; }
  .cost__row { display: grid; grid-template-columns: 8.5rem minmax(0, 1fr) auto; align-items: center; gap: var(--space-3); }
  .cost__name { display: inline-flex; align-items: center; gap: var(--space-2); font-family: var(--font-mono); font-size: var(--text-xs); letter-spacing: var(--tracking-wide); text-transform: uppercase; color: var(--fg-0); }
  .cost__swatch { width: 10px; height: 10px; background: var(--c); }
  .cost__track { height: 10px; background: var(--bg-2); }
  .cost__track--empty { background: repeating-linear-gradient(-45deg, transparent 0 4px, rgba(238, 242, 244, 0.05) 4px 5px); }
  .cost__bar { display: block; height: 100%; background: var(--c); min-width: 1px; }
  .cost__bar--tool { opacity: 0.6; }
  .cost__val { font-family: var(--font-mono); font-size: var(--text-xs); color: var(--ink); white-space: nowrap; }
  .cost__mean { color: var(--fg-3); }
  .cost__none { color: var(--fg-3); text-transform: none; letter-spacing: 0.04em; white-space: normal; }
  .cost__ratio { color: var(--fg-2); text-transform: none; letter-spacing: 0.04em; }
  .cost__prices { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3) var(--space-7); }
  .cost__price { display: flex; align-items: baseline; gap: var(--space-3); }
  .cost__pricev { font-family: var(--font-display); font-weight: 500; font-size: var(--text-lg); color: var(--ink); }
  @media (max-width: 640px) {
    .cost__row { grid-template-columns: 1fr; gap: var(--space-1); }
  }
</style>
