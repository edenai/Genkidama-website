---
/**
 * The way back to the main experience. A small core inside an orbit, the
 * same instrument language as the stage: on hover the orbit tightens and the
 * core charges, a hint of the gathering the visitor came from. Always an
 * explicit link to the homepage, never history.back().
 */
interface Props {
  /** `chrome`: sits in the page header. `footer`: centred closing control. */
  placement?: 'chrome' | 'footer';
}
const { placement = 'chrome' } = Astro.props;
---

<a class:list={['return', `return--${placement}`]} href="/" aria-label="Return to Genkidama, the main experience">
  <span class="return__orbit" aria-hidden="true">
    <span class="return__ring"></span>
    <span class="return__core"></span>
  </span>
  <span class="return__text">
    <span class="return__title">Return to Genkidama</span>
    <span class="return__sub label label--2xs">the main experience</span>
  </span>
</a>

<style>
  .return {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--fg-1);
    padding: var(--space-2) 0;
    transition: color var(--dur-base) var(--ease-out);
  }
  .return--footer { padding: var(--space-4) var(--space-5); border: 1px solid var(--line-strong); }
  .return__orbit {
    position: relative;
    width: 30px;
    height: 30px;
    display: grid;
    place-items: center;
    flex: none;
  }
  .return__ring {
    position: absolute;
    inset: 0;
    border: 1px solid var(--energy-700);
    border-radius: 50%;
    transition: transform var(--dur-slow) var(--ease-energy), border-color var(--dur-base) var(--ease-out);
  }
  .return__ring::before {
    /* A tick on the orbit, pointing home (left). */
    content: '';
    position: absolute;
    left: -1px;
    top: 50%;
    width: 6px;
    height: 1px;
    background: var(--energy-500);
    transform: translate(-100%, -50%);
    transition: width var(--dur-base) var(--ease-out);
  }
  .return__core {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--energy-500);
    box-shadow: var(--glow-sm);
    transition: transform var(--dur-slow) var(--ease-energy), box-shadow var(--dur-base) var(--ease-out), background var(--dur-base) var(--ease-out);
  }
  .return__text { display: grid; gap: 0.15rem; }
  .return__title {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--fg-0);
    white-space: nowrap;
  }
  .return__sub { color: var(--fg-3); white-space: nowrap; }

  .return:hover, .return:focus-visible { color: var(--energy-300); }
  .return:hover .return__ring, .return:focus-visible .return__ring { transform: scale(0.78); border-color: var(--energy-300); }
  .return:hover .return__ring::before, .return:focus-visible .return__ring::before { width: 12px; }
  .return:hover .return__core, .return:focus-visible .return__core { transform: scale(1.5); background: var(--energy-100); box-shadow: var(--glow-md); }
  .return:hover .return__title, .return:focus-visible .return__title { color: var(--energy-300); }
  .return--footer:hover, .return--footer:focus-visible { border-color: var(--energy-500); }

  @media (prefers-reduced-motion: reduce) {
    .return__ring, .return__core, .return__ring::before { transition: none; }
  }
</style>
