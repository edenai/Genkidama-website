---
/**
 * The one visual convention of the experiments: which colour is which system.
 * Cyan is the MCP route (the page's energy), ember is the native route.
 * Repeated near every chart so the reader never has to infer a side.
 */
import { experiments, ARMS } from '@data/experiments';
import { armFill } from './chart';

interface Props {
  /** `full` adds the model identifier and the execution path; `compact` is swatch + label only. */
  variant?: 'full' | 'compact';
  class?: string;
}
const { variant = 'compact', class: className } = Astro.props;
const arms = experiments.arms;
---

<ul class:list={['arms', `arms--${variant}`, className]} aria-label="Systems compared">
  {ARMS.map((arm) => (
    <li class="arms__item" style={`--c: ${armFill(arm)}`}>
      <span class="arms__swatch" aria-hidden="true"></span>
      <span class="arms__text">
        <span class="arms__name">{arms[arm].label}</span>
        {variant === 'full' && (
          <span class="arms__meta label label--2xs"><span class="mono arms__model">{arms[arm].apiModelId ?? arms[arm].model}</span> · {arms[arm].description}</span>
        )}
      </span>
    </li>
  ))}
</ul>

<style>
  .arms { display: flex; flex-wrap: wrap; gap: var(--space-3) var(--space-6); }
  .arms__item { display: flex; align-items: flex-start; gap: var(--space-2); }
  .arms__swatch { width: 12px; height: 12px; margin-top: 0.15em; background: var(--c); flex: none; }
  .arms__text { display: grid; gap: 0.15rem; }
  .arms__name {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--fg-0);
  }
  .arms__meta { color: var(--fg-2); text-transform: none; letter-spacing: 0.04em; line-height: 1.5; max-width: 34rem; }
  .arms__model { color: var(--fg-1); overflow-wrap: anywhere; }
  .arms--full { gap: var(--space-4) var(--space-8); }
  .arms--full .arms__item { flex: 1 1 18rem; }
</style>
