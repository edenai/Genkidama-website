---
/**
 * Latency for one benchmark, both systems. Left: mean total wall-clock
 * latency per run, with the two recorded components (model time, MCP/tool
 * time) drawn as separate thin bars, not stacked, because the recorded parts
 * do not sum to the wall-clock total (round overhead is recorded separately).
 * Right: every run as a dot on a log axis, median marked, so the spread is
 * visible rather than summarised away.
 */
import { experiments, ARMS, fmt, type BenchmarkId } from '@data/experiments';
import { armFill, armInk, log10, logTicks, jitter, sLabel } from './chart';

interface Props { bench: BenchmarkId }
const { bench } = Astro.props;
const b = experiments.benchmarks[bench];
const arms = experiments.arms;

const maxMean = Math.max(...ARMS.map((a) => b.summary[a].latencyMeanS ?? 0));

// Strip plot geometry
const W = 640, H = 150, left = 20, right = 20, top = 22, rowH = 46;
const all = b.samples.flatMap((s) => ARMS.map((a) => s[a].latencyS));
const lo = Math.min(...all), hi = Math.max(...all);
const dMin = 10 ** Math.floor(Math.log10(lo)), dMax = 10 ** Math.ceil(Math.log10(hi));
const x = log10(dMin, dMax, left, W - right);
const ticks = logTicks(dMin, dMax);
---

<figure class="lat frame">
  <figcaption class="frame__bar">
    <span class="label"><span class="dot dot--energy" aria-hidden="true"></span> latency · seconds per run</span>
    <span class="label label--2xs">total wall-clock · {b.sampleCount} runs per system</span>
  </figcaption>

  <div class="lat__body">
    <div class="lat__means">
      {ARMS.map((arm) => {
        const s = b.summary[arm];
        const pct = (v: number | null) => `${((v ?? 0) / maxMean) * 100}%`;
        return (
          <div class="lat__arm" style={`--c: ${armFill(arm)}; --ink: ${armInk[arm]}`}>
            <div class="lat__head">
              <span class="lat__swatch" aria-hidden="true"></span>
              <span class="lat__name">{arms[arm].label}</span>
              <span class="lat__fig num">mean {fmt.s(s.latencyMeanS)} · median {fmt.s(s.latencyMedianS)} · p95 {fmt.s(s.latencyP95S)}</span>
            </div>
            <div class="lat__track" role="img" aria-label={`${arms[arm].label}: mean total wall-clock latency ${fmt.s(s.latencyMeanS)}`}>
              <span class="lat__bar" style={`width: ${pct(s.latencyMeanS)}`}></span>
            </div>
            <dl class="lat__parts">
              <div>
                <dt class="label label--2xs">recorded model time</dt>
                <dd><span class="lat__thin" style={`width: ${pct(s.modelLatencyMeanS)}`}></span><span class="num">{fmt.s(s.modelLatencyMeanS)}</span></dd>
              </div>
              <div>
                <dt class="label label--2xs">recorded MCP/tool time</dt>
                <dd>
                  {(s.toolLatencyMeanS ?? 0) > 0 ? (
                    <><span class="lat__thin lat__thin--tool" style={`width: ${pct(s.toolLatencyMeanS)}`}></span><span class="num">{fmt.s(s.toolLatencyMeanS)}</span></>
                  ) : (
                    <span class="label label--2xs lat__none">none · no tools</span>
                  )}
                </dd>
              </div>
            </dl>
          </div>
        );
      })}
      <p class="lat__note label label--2xs">mean per run · the two recorded components do not add up to the wall-clock total (round overhead is recorded separately)</p>
    </div>

    <div class="lat__spread">
      <svg class="lat__svg" viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`Per-run total latency for both systems on a logarithmic scale; medians ${ARMS.map((a) => `${arms[a].short} ${fmt.s(b.summary[a].latencyMedianS)}`).join(', ')}`}>
        {ticks.map((t) => (
          <g transform={`translate(${x(t)} 0)`}>
            <line class="lat__grid" y1={top - 6} y2={H - 26} />
            <text class="lat__tick" y={H - 12}>{sLabel(t)}s</text>
          </g>
        ))}
        {ARMS.map((arm, i) => {
          const cy = top + i * rowH + rowH / 2;
          const med = b.summary[arm].latencyMedianS ?? 0;
          return (
            <g style={`--c: ${armFill(arm)}`}>
              <text class="lat__row" x={left} y={cy - 16}>{arms[arm].short}</text>
              {b.samples.map((s, k) => (
                <circle class="lat__dot" cx={x(s[arm].latencyS)} cy={cy + jitter(k) * 9} r="3.2">
                  <title>{s.id} · {arms[arm].short} · {fmt.s(s[arm].latencyS)}{s[arm].toolCalls ? ` · ${s[arm].toolCalls} tool calls` : ''}</title>
                </circle>
              ))}
              <line class="lat__median" x1={x(med)} x2={x(med)} y1={cy - 13} y2={cy + 13} />
            </g>
          );
        })}
      </svg>
      <p class="lat__note label label--2xs">one dot per run · log scale · white bar = median</p>
    </div>
  </div>
</figure>

<style>
  .lat__body { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); gap: var(--space-6); padding: var(--space-4); }
  .lat__means { display: grid; gap: var(--space-4); align-content: start; }
  .lat__arm { display: grid; gap: var(--space-2); }
  .lat__head { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-2) var(--space-3); }
  .lat__swatch { width: 10px; height: 10px; background: var(--c); align-self: center; }
  .lat__name { font-family: var(--font-mono); font-size: var(--text-xs); letter-spacing: var(--tracking-label); text-transform: uppercase; color: var(--fg-0); }
  .lat__fig { font-family: var(--font-mono); font-size: var(--text-xs); color: var(--ink); margin-left: auto; }
  .lat__track { height: 10px; background: var(--bg-2); }
  .lat__bar { display: block; height: 100%; background: var(--c); }
  .lat__parts { display: grid; gap: var(--space-1); margin: 0; }
  .lat__parts div { display: grid; grid-template-columns: 11rem 1fr; align-items: center; gap: var(--space-3); }
  .lat__parts dt { color: var(--fg-3); text-transform: none; letter-spacing: 0.04em; }
  .lat__parts dd { margin: 0; display: flex; align-items: center; gap: var(--space-2); font-family: var(--font-mono); font-size: var(--text-xs); color: var(--fg-1); min-width: 0; white-space: nowrap; }
  .lat__thin { display: block; height: 3px; background: var(--c); opacity: 0.9; flex: none; max-width: 70%; }
  .lat__thin--tool { opacity: 0.5; }
  .lat__none { color: var(--fg-3); text-transform: none; letter-spacing: 0.04em; }
  .lat__note { color: var(--fg-3); text-transform: none; letter-spacing: 0.04em; }
  .lat__spread { display: grid; gap: var(--space-2); align-content: start; }
  .lat__svg { width: 100%; height: auto; display: block; }
  .lat__grid { stroke: var(--line); stroke-width: 1; }
  .lat__tick { font-family: var(--font-mono); font-size: 10px; fill: var(--fg-3); text-anchor: middle; }
  .lat__row { font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase; fill: var(--fg-2); }
  .lat__dot { fill: var(--c); opacity: 0.7; }
  .lat__median { stroke: var(--fg-0); stroke-width: 2; }
  @media (max-width: 899px) {
    .lat__body { grid-template-columns: 1fr; }
    .lat__parts div { grid-template-columns: 9rem 1fr; }
  }
</style>
