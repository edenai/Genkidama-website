---
import Marker from '@/components/visual/Marker.astro';
import ToolCallTrace from '@/components/technical/ToolCallTrace.astro';
import CodeBlock from '@/components/technical/CodeBlock.astro';
import TerminalBlock, { type TerminalLine } from '@/components/technical/TerminalBlock.astro';

// Placeholder payloads. Real MCP examples arrive in the content pass.
const toolCall = `{
  "method": "tools/call",
  "params": {
    "name": "eden.ocr.extract",
    "arguments": {
      "file": "receipt-014.jpg",
      "language": "auto"
    }
  }
}`;

const lines: TerminalLine[] = [
  { t: '00.000', kind: 'cmd', text: 'prompt  "What is the total on this receipt?"' },
  { t: '00.412', kind: 'info', text: 'model   text-only · cannot read image' },
  { t: '00.418', kind: 'mcp', text: 'tools/call eden.ocr.extract  →  mcp gateway' },
  { t: '00.830', kind: 'ok', text: 'ocr     412 ms · 1.2 kB text returned' },
  { t: '01.204', kind: 'out', text: 'answer  "The total is €48.20."' },
];
---

<section class="section compose" id="composition" aria-labelledby="compose-title">
  <div class="container">
    <div class="section__head">
      <Marker index="04" title="The composition" />
      <span class="label label--2xs">one call, out and back</span>
    </div>

    <div class="grid compose__grid">
      <div style="grid-column: 1 / span 4" data-reveal>
        <h2 id="compose-title" class="display display--lg">Request out.<br />Result back.<br />Context grows.</h2>
        <p class="prose" style="margin-top: var(--space-4)">
          The model emits a tool call. The gateway routes it to the specialist, the specialist
          answers, and the answer returns as text the model can reason over. What follows is a
          placeholder trace of that round trip.
        </p>
      </div>

      <div style="grid-column: 5 / span 3" data-reveal data-reveal-delay="0.1">
        <ToolCallTrace />
      </div>

      <div class="compose__stack" style="grid-column: 8 / span 5" data-reveal data-reveal-delay="0.2">
        <CodeBlock code={toolCall} lang="json" title="tool_call.json" note="request · placeholder" />
        <TerminalBlock title="session · placeholder" lines={lines} />
      </div>
    </div>
  </div>
</section>

<style>
  .compose__stack { display: grid; gap: var(--space-5); align-content: start; }
</style>
