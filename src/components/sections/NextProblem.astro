---
import Marker from '@/components/visual/Marker.astro';
---

<section class="section next" id="next" aria-labelledby="next-title">
  <div class="container">
    <div class="section__head">
      <Marker index="05" title="The next problem" />
      <span class="label label--2xs">open questions</span>
    </div>

    <div class="grid">
      <h2 id="next-title" class="display display--xl next__statement" style="grid-column: 1 / span 9" data-reveal>
        If capability can be <span class="energy">gathered</span>,<br />what should a model be?
      </h2>

      <ol class="next__questions" style="grid-column: 1 / span 6" data-reveal data-reveal-delay="0.1">
        <li><span class="next__n">01</span>When does routing overhead outweigh the benefit?</li>
        <li><span class="next__n">02</span>How should a model decide when to call a specialist?</li>
        <li><span class="next__n">03</span>How should a system recover when a tool fails?</li>
      </ol>

      <div class="next__actions" style="grid-column: 8 / span 5" data-reveal data-reveal-delay="0.2">
        <a class="btn btn--solid" href="https://www.edenai.co" target="_blank" rel="noopener noreferrer">Eden AI ↗</a>
        <a class="btn" href="#bridge">MCP server</a>
        <a class="btn" href="#top">Back to the core</a>
      </div>
    </div>
  </div>
</section>

<style>
  .next { padding-bottom: clamp(var(--space-9), 14vh, var(--space-11)); }
  .next__questions { display: grid; gap: var(--space-3); color: var(--fg-1); }
  .next__questions li { display: grid; grid-template-columns: 2.4rem 1fr; gap: var(--space-2); padding: var(--space-3) 0; border-top: 1px solid var(--line); }
  .next__n { font-family: var(--font-mono); font-size: var(--text-xs); color: var(--energy-500); padding-top: 0.25em; }
  .next__actions { display: flex; flex-wrap: wrap; gap: var(--space-3); align-content: start; }
</style>
