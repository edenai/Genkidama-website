---
import Marker from '@/components/visual/Marker.astro';
import ArchitectureDiagram from '@/components/technical/ArchitectureDiagram.astro';
import ToolCallTrace, { type TraceStep } from '@/components/technical/ToolCallTrace.astro';
import CodeBlock from '@/components/technical/CodeBlock.astro';
import TerminalBlock, { type TerminalLine } from '@/components/technical/TerminalBlock.astro';
import { MCP_DOCS_URL } from '@data/mcpCatalog';

// Example round trip through one specialist (OCR). An illustrative interaction,
// not a measurement: the experiments live on the details page.
const toolCall = `{
  "method": "tools/call",
  "params": {
    "name": "ocr",
    "arguments": {
      "file": "receipt-014.jpg",
      "language": "auto"
    }
  }
}`;

const steps: TraceStep[] = [
  { kind: 'model', label: 'MODEL', detail: 'text-only · decides it needs OCR' },
  { kind: 'mcp', label: 'MCP', detail: 'eden ai gateway · routes the call' },
  { kind: 'tool', label: 'OCR', detail: 'ocr · reads the image' },
  { kind: 'result', label: 'RESULT', detail: 'text · returned as context' },
  { kind: 'model', label: 'MODEL', detail: 'continues reasoning' },
];

const lines: TerminalLine[] = [
  { t: '00.000', kind: 'cmd', text: 'prompt  "What is the total on this receipt?"' },
  { t: '00.412', kind: 'info', text: 'model   text-only · cannot read the image' },
  { t: '00.418', kind: 'mcp', text: 'tools/call ocr  →  mcp gateway' },
  { t: '00.830', kind: 'ok', text: 'ocr     text returned' },
  { t: '01.204', kind: 'out', text: 'answer  "The total is €48.20."' },
];
---

<section class="section bridge" id="bridge" aria-labelledby="bridge-title">
  <div class="container">
    <div class="section__head">
      <Marker index="03" title="The bridge" />
      <span class="label label--2xs">model context protocol</span>
    </div>

    <div class="grid">
      <div style="grid-column: 1 / span 12" data-reveal>
        <ArchitectureDiagram />
      </div>

      <div style="grid-column: 1 / span 4" data-reveal>
        <h2 id="bridge-title" class="display display--lg">One protocol between the model and everything it lacks.</h2>
      </div>
      <div style="grid-column: 6 / span 6" data-reveal data-reveal-delay="0.1">
        <p class="prose">
          MCP is a standard interface between a model and external tools. Instead of building
          every capability into the model, an agent discovers the tools a server exposes, calls
          the one it needs and reads the result back as context.
        </p>
        <p class="prose">
          Eden AI's hosted MCP server exposes its expert models this way: one tool per feature,
          plus a few utilities. OCR, image analysis, web search, speech, translation and the rest
          of the catalogue become callable by any MCP-capable agent, and the catalogue is
          discovered at runtime rather than hardcoded.
        </p>
        <ul class="bridge__facts">
          <li><span class="label">discovery</span><span class="mono">tools/list</span></li>
          <li><span class="label">invocation</span><span class="mono">tools/call</span></li>
          <li><span class="label">return</span><span class="mono">text · structured</span></li>
        </ul>
        <a class="bridge__doc label" href={MCP_DOCS_URL} target="_blank" rel="noopener noreferrer">
          Read the MCP server documentation <span aria-hidden="true">↗</span>
        </a>
      </div>

      <div class="rule" style="grid-column: 1 / -1" data-reveal="rule"></div>

      {/* One call, out and back: what actually happens during a tool call. */}
      <div style="grid-column: 1 / span 4" data-reveal>
        <h3 class="display display--md">One call, out and back.</h3>
        <p class="prose" style="margin-top: var(--space-4)">
          The model decides it needs a capability and emits a tool call. The gateway routes it
          to the specialist; the result returns as text, and the model keeps reasoning with it.
          One example, through OCR:
        </p>
      </div>

      <div style="grid-column: 5 / span 3" data-reveal data-reveal-delay="0.1">
        <ToolCallTrace steps={steps} />
      </div>

      <div class="bridge__stack" style="grid-column: 8 / span 5" data-reveal data-reveal-delay="0.2">
        <CodeBlock code={toolCall} lang="json" title="tool_call.json" note="request · example" />
        <TerminalBlock title="example session · illustrative" lines={lines} />
      </div>
    </div>
  </div>
</section>

<style>
  .bridge__facts { display: grid; gap: var(--space-2); margin-top: var(--space-6); max-width: var(--measure); }
  .bridge__facts li { display: grid; grid-template-columns: 8rem 1fr; padding: var(--space-2) 0; border-top: 1px solid var(--line); font-size: var(--text-sm); color: var(--fg-0); }
  .bridge__doc {
    display: inline-flex;
    gap: 0.5em;
    margin-top: var(--space-5);
    color: var(--fg-1);
    border-bottom: 1px solid var(--line-energy);
    padding-bottom: 0.2em;
    transition: color var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out);
  }
  .bridge__doc:hover { color: var(--energy-300); border-bottom-color: var(--energy-500); }
  .bridge__stack { display: grid; gap: var(--space-5); align-content: start; }
</style>
