---
/**
 * 03 / THE EXPERIMENTS: the evidence, visually. A two-sentence overview, the
 * routes compared, two benchmark cards, then one panel per benchmark
 * (performance and cost side by side, tools used underneath), a compact
 * cross-benchmark takeaway, and one disclosure with the method.
 *
 * Every number here comes from `src/data/experiments/showcase.json`,
 * generated by `scripts/curate-showcase.mjs` and cross-checked against the
 * analysis notebook. Nothing is typed in. No winner is declared.
 */
import Marker from '@/components/visual/Marker.astro';
import ArmLegend from '@/components/experiments/ArmLegend.astro';
import ExperimentPanel from '@/components/experiments/ExperimentPanel.astro';
import Takeaway from '@/components/experiments/Takeaway.astro';
import { experiments as E, ARMS, armsOf, evaluatedAt } from '@data/experiments';
import { MCP_DOCS_URL } from '@data/mcpCatalog';

const ocr = E.benchmarks.mmmu_pro;
const sp = E.benchmarks.spoken_squad;
const totalRuns = ARMS.reduce((n, a) => n + (armsOf('mmmu_pro').includes(a) ? ocr.sampleCount : 0) + (armsOf('spoken_squad').includes(a) ? sp.sampleCount : 0), 0);
const ocrDomains = new Set(ocr.samples.map((s) => s.group)).size;
const sampledOcr = ocr.sampledTasks ?? ocr.fullRun.pairedTasks;
const sampledSp = sp.sampledTasks ?? sp.fullRun.pairedTasks;
const MCP_UTILITIES = new Set(['check_job', 'list_models', 'run_tool', 'search_tools', 'upload_file']);
const directTools = (ocr.mcpToolNames ?? []).filter((t) => !MCP_UTILITIES.has(t));
const catalogueNote = ocr.mcpToolNames?.includes('run_tool')
  ? `${directTools.join(' and ')} directly, any other Eden AI tool through search_tools and run_tool`
  : 'the complete catalogue';

const cards = [
  {
    id: 'mmmu_pro',
    kicker: 'OCR / vision',
    name: ocr.dataset,
    text: `College exam questions where the whole task is a screenshot: text, options and figure. ${ocr.sampleCount} tasks over ${ocrDomains} domains.`,
    meta: `${ocr.sampleCount} tasks · ${ocr.scoreMetric} · official parser`,
  },
  {
    id: 'spoken_squad',
    kicker: 'Speech',
    name: sp.dataset,
    text: `Questions about a Wikipedia passage that is only available as a recording. ${sp.sampleCount} questions, one per paragraph.`,
    meta: `${sp.sampleCount} questions · ${sp.scoreMetric} · SQuAD v1.1`,
  },
];
---

<section class="section experiments" id="experiments" aria-labelledby="experiments-title">
  <div class="container">
    <div class="section__head">
      <Marker index="03" title="The experiments" />
      <span class="label label--2xs">{ocr.dataset} · {sp.dataset} · {totalRuns} runs · evaluated {evaluatedAt}</span>
    </div>

    {/* Overview */}
    <div class="grid experiments__intro">
      <h2 id="experiments-title" class="display display--lg" style="grid-column: 1 / span 5" data-reveal>
        Two benchmarks. Two routes. <span class="energy">Measured.</span>
      </h2>
      <div class="experiments__lead" style="grid-column: 7 / span 6" data-reveal data-reveal-delay="0.1">
        <p class="prose">
          Every task goes to every system with the same prompt, the same uploaded asset and the same
          limits. One model reads the image or audio natively; a text-only model reaches it through
          Eden AI's MCP tools. Two things are compared: what each route scored, and what each run cost.
        </p>
        <ArmLegend variant="full" />
      </div>

      <ul class="experiments__cards" style="grid-column: 1 / -1" data-reveal>
        {cards.map((c) => (
          <li class="bench frame">
            <a class="bench__link" href={`#${c.id}`}>
              <span class="bench__visual" aria-hidden="true">
                {c.id === 'mmmu_pro' ? (
                  <svg viewBox="0 0 120 80" class="bench__svg">
                    <rect x="8" y="6" width="104" height="68" class="bench__frame" />
                    <rect x="18" y="16" width="60" height="4" class="bench__line" />
                    <rect x="18" y="26" width="84" height="3" class="bench__line bench__line--dim" />
                    <rect x="18" y="34" width="72" height="3" class="bench__line bench__line--dim" />
                    <rect x="18" y="46" width="40" height="3" class="bench__line bench__line--dim" />
                    <rect x="18" y="54" width="40" height="3" class="bench__line bench__line--dim" />
                    <rect x="18" y="62" width="40" height="3" class="bench__line bench__line--hot" />
                    <rect x="70" y="42" width="32" height="24" class="bench__figure" />
                    <path d="M74 60 L82 50 L90 56 L98 46" class="bench__plot" />
                  </svg>
                ) : (
                  <svg viewBox="0 0 120 80" class="bench__svg">
                    {Array.from({ length: 23 }, (_, i) => {
                      const h = 6 + Math.round(26 * Math.abs(Math.sin(i * 0.9) * Math.cos(i * 0.37)));
                      return <rect x={10 + i * 4.4} y={40 - h / 2} width="2.4" height={h} class:list={['bench__wave', { 'bench__wave--hot': i >= 9 && i <= 14 }]} />;
                    })}
                  </svg>
                )}
              </span>
              <span class="bench__text">
                <span class="label label--energy">{c.kicker}</span>
                <span class="bench__name">{c.name}</span>
                <span class="bench__desc">{c.text}</span>
                <span class="bench__meta label label--2xs">{c.meta}</span>
              </span>
              <span class="bench__cta label">results <span aria-hidden="true">↓</span></span>
            </a>
          </li>
        ))}
      </ul>

      <p class="experiments__sample label label--2xs" style="grid-column: 1 / span 9" data-reveal>
        <span class="dot dot--ember" aria-hidden="true"></span>
        <span>The {ocr.sampleCount} + {sp.sampleCount} tasks shown are a curated subset of {sampledOcr} + {sampledSp} sampled tasks, selected by rule so that the MCP route did at least as well as the native one. They show what that route can deliver on the tasks it handles, not how often it does.</span>
      </p>
    </div>

    <ExperimentPanel
      bench="mmmu_pro"
      index="ocr / vision"
      title="Read the exam from a screenshot, then answer it."
      caption={`The text-only model never sees the pixels; it must call a tool that reads them. Score: ${ocr.scoreDefinition} over ${ocr.sampleCount} tasks.`}
    />

    <ExperimentPanel
      bench="spoken_squad"
      index="speech"
      title="Listen to the passage, then answer from what was said."
      caption={`The text-only model must get a transcript through a tool before it can answer. Score: ${sp.scoreDefinition} over ${sp.sampleCount} questions.`}
    />

    {/* Across both */}
    <div class="experiments__part" id="across">
      <div class="section__head experiments__subhead">
        <Marker index="across both" title="performance & cost" />
        <span class="label label--2xs">no composite score</span>
      </div>
      <div class="grid">
        <div style="grid-column: 1 / -1" data-reveal><Takeaway /></div>

        <details class="experiments__method" style="grid-column: 1 / span 8" data-reveal>
          <summary class="label"><span class="experiments__chevron" aria-hidden="true"></span> How these figures were made</summary>
          <dl>
            <div><dt>Samples</dt><dd>{sampledOcr} {ocr.dataset} tasks (config vision, test split, stratified over 30 subjects) and {sampledSp} {sp.dataset} questions (test split, one per paragraph) were drawn at random, seed 42, and run on every system. {ocr.sampleCount} and {sp.sampleCount} of them are shown: tasks where the MCP route did at least as well as the native one, ordered by cost overhead. Tasks where the MCP route failed, or the native route scored higher, are not shown.</dd></div>
            <div><dt>Routes</dt><dd>The asset is uploaded once. The MCP route gets its Eden AI file ID and a {ocr.mcpToolCount}-tool catalogue ({catalogueNote}); the native route gets the image or audio as a content part and no tools. Shared limits: {ocr.policy?.maxRounds} rounds, {ocr.policy?.maxToolCalls} tool calls per run.</dd></div>
            <div><dt>Scores</dt><dd>MMMU-Pro: accuracy with the official multiple-choice parser. Spoken-SQuAD: SQuAD v1.1 exact match and token F1, maximum over the reference answers. Runs with no scorable answer are counted apart, never as zero.</dd></div>
            <div><dt>Cost</dt><dd>Two recorded fields per run, in USD, never estimated from list prices and never added together: the gateway charge the Eden AI gateway reports for the model's rounds (every route), and the specialist-tool charge reported inside MCP tool results, counted once per job (MCP route only). The native route's recorded cost is its gateway charge alone. Time and token counts were recorded but are not compared: a route through MCP has more rounds by construction.</dd></div>
            <div><dt>Source</dt><dd><span class="mono">{E.provenance.repository}</span> · <span class="mono">{E.provenance.folder}</span>, assembled {E.provenance.assembledAt.slice(0, 10)}, runs <span class="mono">{E.provenance.sources.mmmu_pro.runName}</span> and <span class="mono">{E.provenance.sources.spoken_squad.runName}</span>; curated by <span class="mono">{E.provenance.curationScript}</span>, cross-checked against <span class="mono">{E.provenance.notebook}</span>.</dd></div>
          </dl>
        </details>

        <div class="experiments__actions" style="grid-column: 1 / -1" data-reveal>
          <a class="btn btn--solid" href="https://www.edenai.co" target="_blank" rel="noopener noreferrer">Eden AI ↗</a>
          <a class="btn" href={MCP_DOCS_URL} target="_blank" rel="noopener noreferrer">MCP server documentation ↗</a>
          <a class="btn" href="#top">Back to the core</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Last section before the footer: carry the page's closing space. */
  .experiments { padding-bottom: clamp(var(--space-9), 14vh, var(--space-11)); }
  .experiments__intro { row-gap: var(--space-7); }
  .experiments__lead { display: grid; gap: var(--space-5); align-content: start; }

  .experiments__cards { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-4); }
  .bench { transition: border-color var(--dur-fast) var(--ease-out); }
  .bench:hover { border-color: var(--line-energy); }
  .bench__link { display: grid; grid-template-columns: 9rem minmax(0, 1fr) auto; gap: var(--space-4); align-items: center; padding: var(--space-4); }
  .bench__visual { display: block; }
  .bench__svg { width: 100%; height: auto; display: block; }
  .bench__frame { fill: var(--bg-0); stroke: var(--fg-2); stroke-width: 1; }
  .bench__line { fill: var(--fg-0); }
  .bench__line--dim { fill: var(--fg-3); }
  .bench__line--hot { fill: var(--energy-500); }
  .bench__figure { fill: none; stroke: var(--fg-3); stroke-width: 1; }
  .bench__plot { fill: none; stroke: var(--energy-300); stroke-width: 1.5; }
  .bench__wave { fill: var(--fg-2); }
  .bench__wave--hot { fill: var(--energy-500); }
  .bench__text { display: grid; gap: var(--space-2); }
  .bench__name { font-family: var(--font-display); font-weight: 600; font-size: var(--text-lg); line-height: 1.1; color: var(--fg-0); }
  .bench__desc { font-size: var(--text-sm); color: var(--fg-1); line-height: 1.5; }
  .bench__meta { color: var(--fg-3); }
  .bench__cta { display: inline-flex; gap: 0.5em; color: var(--fg-1); border-bottom: 1px solid var(--line-energy); padding-bottom: 0.2em; white-space: nowrap; transition: color var(--dur-fast) var(--ease-out); }
  .bench:hover .bench__cta { color: var(--energy-300); }

  .experiments__sample { display: flex; gap: var(--space-3); align-items: flex-start; color: var(--fg-2); text-transform: none; letter-spacing: 0.04em; line-height: 1.6; }
  .experiments__sample .dot { margin-top: 0.5em; flex: none; }

  .experiments__part { padding-top: clamp(var(--space-9), 10vh, var(--space-11)); scroll-margin-top: var(--space-8); }
  .experiments__subhead { margin-bottom: clamp(var(--space-6), 5vh, var(--space-8)); }
  .experiments__subhead .marker { white-space: normal; }
  .experiments__part .grid { row-gap: var(--space-6); }

  .experiments__method summary { display: inline-flex; align-items: center; gap: var(--space-3); cursor: pointer; list-style: none; color: var(--fg-1); padding: var(--space-2) 0; transition: color var(--dur-fast) var(--ease-out); }
  .experiments__method summary::-webkit-details-marker { display: none; }
  .experiments__method summary:hover { color: var(--energy-300); }
  .experiments__chevron { width: 8px; height: 8px; border-right: 1px solid currentColor; border-bottom: 1px solid currentColor; transform: rotate(-45deg); transition: transform var(--dur-fast) var(--ease-out); }
  .experiments__method[open] .experiments__chevron { transform: rotate(45deg); }
  .experiments__method dl { display: grid; gap: var(--space-3); margin: var(--space-3) 0 0; color: var(--fg-1); font-size: var(--text-sm); line-height: 1.6; }
  .experiments__method dl div { display: grid; grid-template-columns: 6rem 1fr; gap: var(--space-3); padding-top: var(--space-3); border-top: 1px solid var(--line); }
  .experiments__method dt { font-family: var(--font-mono); font-size: var(--text-xs); letter-spacing: var(--tracking-label); text-transform: uppercase; color: var(--energy-500); padding-top: 0.3em; }
  .experiments__method dd { margin: 0; }
  .experiments__method .mono { overflow-wrap: anywhere; color: var(--fg-0); }
  .experiments__actions { display: flex; flex-wrap: wrap; gap: var(--space-3); padding-top: var(--space-6); border-top: 1px solid var(--line); }

  @media (max-width: 899px) {
    .experiments__cards { grid-template-columns: 1fr; }
    .experiments__method dl div { grid-template-columns: 1fr; gap: var(--space-1); }
  }
  @media (max-width: 640px) {
    .bench__link { grid-template-columns: 1fr; }
    .bench__visual { max-width: 9rem; }
  }
</style>
