---
import { sections, externalLinks } from '@data/navigation';
---

<header class="nav" role="banner">
  <a class="nav__mark" href="#top" aria-label="Genkidama — back to top">
    <span class="nav__glyph" aria-hidden="true"></span>
    <span class="nav__word">GENKIDAMA</span>
    <span class="nav__by label label--2xs">by Eden AI</span>
  </a>

  <nav class="nav__sections" aria-label="Sections">
    <ol>
      {sections.map((s) => (
        <li>
          <a href={`#${s.id}`} data-section-link={s.id}>
            <span class="nav__index">{s.index}</span>
            <span class="nav__title">{s.title}</span>
          </a>
        </li>
      ))}
    </ol>
  </nav>

  <div class="nav__links">
    {externalLinks.map((l, i) => (
      <>
        {/* Between the two links, a tiny profile projects a concentrated
            stream from the MCP server side toward Eden AI. */}
        {i > 0 && (
          <span class="nav__egg" aria-hidden="true">
            <svg viewBox="12 0 92 34" focusable="false">
              <line class="nav__egg-track" x1="14" y1="17.3" x2="58" y2="17.3" vector-effect="non-scaling-stroke" />
              <line class="nav__egg-packet" x1="50" y1="17.3" x2="58" y2="17.3" vector-effect="non-scaling-stroke" />
              <circle class="nav__egg-charge" cx="58.6" cy="17.3" r="1.3" />
              <path
                class="nav__egg-figure"
                d="M61 14.8 L66 15.2 L82.2 16.2 L81.4 14.2 L78.6 13.6 L76.6 12 L75.4 10 L77 7.5 L78 5.5 L71.8 0.6 L79.4 3.2 L81.8 0.2 L84.4 3 L88.8 0.2 L87.6 4.6 L97.2 2 L89.6 7 L100.4 9 L90.2 9.8 L97.4 14.6 L89.2 12.4 L88.4 14.4 L87.8 16 L90 17.6 L91.8 21.4 L91 25 L95.6 28.4 L100.8 33.6 L97.2 33.6 L92.4 29.8 L88.4 27.6 L80 29.6 L73.4 33.6 L77.6 33.6 L84.8 30 L86 25.6 L85 22.4 L84 19.6 L66 19.2 L61 19.4 L59.2 18.4 L59 15.8 Z"
              />
            </svg>
          </span>
        )}
        <a
          class="label label--strong"
          href={l.href}
          target={l.external ? '_blank' : undefined}
          rel={l.external ? 'noopener noreferrer' : undefined}
        >
          {l.label}{l.external && <span aria-hidden="true"> ↗</span>}
        </a>
      </>
    ))}
  </div>
</header>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: var(--z-nav);
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--space-6);
    padding: var(--space-4) var(--gutter);
    pointer-events: none;
    /* No solid bar: a soft occluder so text stays readable over the stage. */
    background: linear-gradient(to bottom, rgba(5, 7, 8, 0.85), rgba(5, 7, 8, 0));
  }
  .nav > * { pointer-events: auto; }

  .nav__mark {
    white-space: nowrap;
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-3);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-sm);
    letter-spacing: 0.22em;
    color: var(--fg-0);
  }
  .nav__glyph {
    align-self: center;
    width: 8px; height: 8px;
    background: var(--energy-500);
    box-shadow: var(--glow-sm);
  }
  .nav__by { color: var(--fg-2); letter-spacing: var(--tracking-label); }

  .nav__sections ol {
    display: flex;
    justify-content: center;
    gap: var(--space-5);
  }
  .nav__sections a {
    white-space: nowrap;
    display: inline-flex;
    align-items: baseline;
    gap: 0.5em;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--fg-2);
    padding: var(--space-1) 0;
    border-bottom: 1px solid transparent;
    transition: color var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out);
  }
  .nav__sections a:hover { color: var(--fg-0); }
  .nav__sections a.is-current { color: var(--fg-0); border-bottom-color: var(--energy-500); }
  .nav__index { color: var(--energy-500); }
  .nav__title { display: none; }
  @media (min-width: 1500px) { .nav__title { display: inline; } }

  .nav__links { display: flex; gap: var(--space-5); }
  .nav__links a { white-space: nowrap; }

  /* Easter egg. Zero-height flex item so the row keeps its metrics; the glyph
     is centred on the labels and eats half of each neighbouring gap. */
  .nav__egg {
    display: flex;
    align-items: center;
    align-self: center;
    height: 0;
    margin-inline: calc(var(--space-5) * -0.5);
  }
  .nav__egg svg { display: block; height: 16px; width: auto; overflow: visible; }
  .nav__egg-figure { fill: var(--fg-2); opacity: 0.7; }
  .nav__egg-track { stroke: var(--line-strong); stroke-width: 1; }
  .nav__egg-packet {
    stroke: var(--energy-500);
    stroke-width: 1;
    filter: drop-shadow(0 0 3px rgba(34, 211, 240, 0.7)); /* --glow-sm, tightened for a 1px stroke */
    animation: nav-egg-travel 1.8s cubic-bezier(0.65, 0, 0.35, 1) infinite;
  }
  .nav__egg-charge { fill: var(--energy-300); filter: drop-shadow(0 0 3px rgba(34, 211, 240, 0.8)); }
  @keyframes nav-egg-travel {
    from { transform: translateX(0); }
    to { transform: translateX(-46px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .nav__egg-packet { animation: none; }
  }

  @media (max-width: 899px) {
    .nav { grid-template-columns: 1fr auto; gap: var(--space-4); }
    .nav__sections { display: none; }
    .nav__by { display: none; }
  }
  @media (max-width: 640px) {
    .nav__egg { display: none; }
  }
</style>
