---
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__col">
      <span class="label label--strong">Genkidama</span>
      <p class="footer__note">An Eden AI research project on capability composition through MCP.</p>
    </div>
    <div class="footer__col">
      <span class="label">Index</span>
      <ul class="footer__list">
        <li><a href="/#idea">01 The idea</a></li>
        <li><a href="/#bridge">03 The bridge</a></li>
        <li><a href="/#next">04 The next problem</a></li>
        <li><a href="/details" class="footer__quiet">Details · experiments, in progress</a></li>
      </ul>
    </div>
    <div class="footer__col">
      <span class="label">Eden AI</span>
      <ul class="footer__list">
        <li><a href="https://www.edenai.co" target="_blank" rel="noopener noreferrer">edenai.co ↗</a></li>
        <li><a href="https://docs.edenai.co" target="_blank" rel="noopener noreferrer">Documentation ↗</a></li>
      </ul>
    </div>
    <div class="footer__meta label label--2xs">
      <span>© {year} Eden AI</span>
      <span>Site v0.1 · visual system phase</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    z-index: var(--z-content);
    border-top: 1px solid var(--line);
    background: var(--bg-0);
    padding-block: var(--space-8) var(--space-6);
  }
  .footer__inner {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: var(--space-6);
  }
  .footer__col { display: grid; gap: var(--space-3); align-content: start; }
  .footer__note { color: var(--fg-2); font-size: var(--text-sm); max-width: 28rem; }
  .footer__list { display: grid; gap: var(--space-2); }
  .footer__list a {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--fg-1);
  }
  .footer__list a:hover { color: var(--energy-300); }
  .footer__list .footer__quiet { color: var(--fg-3); }
  .footer__meta {
    grid-column: 1 / -1;
    display: flex;
    justify-content: space-between;
    padding-top: var(--space-5);
    border-top: 1px solid var(--line);
    color: var(--fg-3);
  }
  @media (max-width: 899px) {
    .footer__inner { grid-template-columns: 1fr 1fr; }
    .footer__col:first-child { grid-column: 1 / -1; }
    .footer__meta { flex-direction: column; gap: var(--space-2); }
  }
</style>
